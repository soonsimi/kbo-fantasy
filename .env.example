# Firebase 웹 앱 설정.
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요 (.env.local 은 git에 올라가지 않습니다).
#
# 값 찾는 곳: Firebase 콘솔 → 프로젝트 설정 → 내 앱 → SDK 설정 및 구성
#
# 이 값들을 비워두면 앱은 localStorage에 저장하며 그대로 동작합니다.
# Firebase 웹 API 키는 비밀값이 아니라 프로젝트 식별자입니다.
# 실제 접근 통제는 firestore.rules 가 담당합니다.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
